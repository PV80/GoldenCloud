<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GoldenCloud.Tray</RootNamespace>
    <AssemblyName>GoldenCloud.Tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- One file, no .NET install needed on staff PCs. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoldenCloud.Core\GoldenCloud.Core.csproj" />
  </ItemGroup>

  <!--
    D-007: the server address is baked in at build time.

    build.ps1 passes -p:GoldenCloudServerUrl=<url> taken from the
    GOLDENCLOUD_SERVER_URL environment variable. The value is written into a
    generated source file under obj/ rather than edited into a checked-in .cs,
    so the working tree is never dirtied and the build stays idempotent.
    WriteOnlyWhenDifferent keeps incremental builds from recompiling for nothing.
  -->
  <PropertyGroup>
    <GoldenCloudUnconfiguredServerUrl>https://cloud.example.com</GoldenCloudUnconfiguredServerUrl>
    <GoldenCloudServerUrl Condition="'$(GoldenCloudServerUrl)' == ''">$(GoldenCloudUnconfiguredServerUrl)</GoldenCloudServerUrl>
    <GoldenCloudIsConfigured>false</GoldenCloudIsConfigured>
    <GoldenCloudIsConfigured Condition="'$(GoldenCloudServerUrl)' != '$(GoldenCloudUnconfiguredServerUrl)'">true</GoldenCloudIsConfigured>
  </PropertyGroup>

  <Target Name="GenerateGoldenCloudBuildConfig" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <GoldenCloudBuildConfigPath>$(IntermediateOutputPath)GoldenCloudBuildConfig.g.cs</GoldenCloudBuildConfigPath>
    </PropertyGroup>

    <ItemGroup>
      <GoldenCloudBuildConfigLine Include="// &lt;auto-generated /&gt;" />
      <GoldenCloudBuildConfigLine Include="// Generated by GoldenCloud.Tray.csproj. Do not edit and do not commit." />
      <GoldenCloudBuildConfigLine Include="namespace GoldenCloud.Tray%3B" />
      <GoldenCloudBuildConfigLine Include="/// &lt;summary&gt;Values fixed when this executable was built (D-007).&lt;/summary&gt;" />
      <GoldenCloudBuildConfigLine Include="internal static class BuildConfig" />
      <GoldenCloudBuildConfigLine Include="{" />
      <GoldenCloudBuildConfigLine Include="    /// &lt;summary&gt;The server every copy of this build talks to.&lt;/summary&gt;" />
      <GoldenCloudBuildConfigLine Include="    public const string ServerUrl = &quot;$(GoldenCloudServerUrl)&quot;%3B" />
      <GoldenCloudBuildConfigLine Include="    /// &lt;summary&gt;The placeholder used when no address was supplied.&lt;/summary&gt;" />
      <GoldenCloudBuildConfigLine Include="    public const string UnconfiguredServerUrl = &quot;$(GoldenCloudUnconfiguredServerUrl)&quot;%3B" />
      <GoldenCloudBuildConfigLine Include="    /// &lt;summary&gt;False when this build must not be handed to staff.&lt;/summary&gt;" />
      <GoldenCloudBuildConfigLine Include="    public const bool IsConfigured = $(GoldenCloudIsConfigured)%3B" />
      <GoldenCloudBuildConfigLine Include="}" />
    </ItemGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
      File="$(GoldenCloudBuildConfigPath)"
      Lines="@(GoldenCloudBuildConfigLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(GoldenCloudBuildConfigPath)" />
      <FileWrites Include="$(GoldenCloudBuildConfigPath)" />
    </ItemGroup>
  </Target>

</Project>
