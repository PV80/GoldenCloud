<Project>

  <!--
    Shared settings for every project under client/.

    EnableWindowsTargeting lets `dotnet restore` and `dotnet build` of the
    net8.0-windows project succeed on a non-Windows machine, which is how the
    code is authored. The binaries that ship are always produced on Windows.

    Nullable is ON, but nullable warnings are deliberately NOT promoted to
    errors: this tree is authored without a .NET SDK available, so a single
    over-strict flow-analysis disagreement would turn a green CI red for a
    non-defect. CI still surfaces them as warnings.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>GoldenCloud</Product>
    <Company>GoldenCloud</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
